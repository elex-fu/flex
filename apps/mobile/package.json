{
  "name": "@flyx/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --offline",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flyx/client-core": "workspace:*",
    "@flyx/mvp-protocol": "workspace:*",
    "@flyx/secure-channel": "workspace:*",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-community/netinfo": "11.4.1",
    "buffer": "6.0.3",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "type": "module"
}
