{
  "name": "@flyx/mvp-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:spike": "vitest run src/claude/adapter.spike.test.ts",
    "test:codex-spike": "vitest run src/codex/adapter.spike.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@flyx/mvp-protocol": "workspace:*",
    "@flyx/secure-channel": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "pino": "^10.2.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flyx/client-core": "workspace:*",
    "@flyx/mvp-relay": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.6"
  }
}
